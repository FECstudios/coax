# Agent cüzdanı: deploy eder, verdict/finish gönderir, musluktan MON dağıtır. Testnet MON ile doldur.
AGENT_PRIVATE_KEY=0x...
# Hack Club AI anahtarı (bekçi LLM + jev)
HACKCLUB_API_KEY=
# 1 = LLM/jev çağırmadan sahte bekçi ("susam" geçen mesaj kasayı açar). Yerel test için.
MOCK_AI=0

RPC_URL=https://testnet-rpc.monad.xyz
# Telefonlara verilecek RPC (boşsa RPC_URL)
PUBLIC_RPC_URL=
# QR kodun göstereceği adres (tünel/Vercel URL'si). Boşsa isteğin Host başlığı.
PUBLIC_URL=
PORT=3000

# Boşsa her tur rastgele senaryo (scenarios/index.json: klasik, uykulu, paragoz, robot, muze, sahte_opus, readme)
SCENARIO=
# Boşsa zayıf model havuzundan kontrat adresine göre seçilir
GUARD_MODEL=
GUARD_TEMPERATURE=0.7
JEV_THRESHOLD=0.8
LLM_CONCURRENCY=8

# Deploy (her tur yeni deploy). Prova: 600, demo: 180
DURATION_SEC=180
INITIAL_FEE_MON=0.1
GROWTH_BPS=500
SEED_MON=1

# Musluk: burner cüzdana ilk girişte. 0 = kapalı
DRIP_MON=1
DRIP_MAX_WALLETS=60

# Coaxer çoklu kasa kontratı (node src/coax-deploy.ts → coax.json)
COAX_FILE=
# Testnet ERC-20 adresleri (mainnet'e geçerken değiştir)
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3
WETH_ADDRESS=0x45477f4709771331db81944A5E20eF95Bc7BA2D7
WMON_ADDRESS=0xFb8bf4c1CC7a94c73D209a149eA2AbEa852BC541
